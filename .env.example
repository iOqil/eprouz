NUXT_PUBLIC_SITE_URL=https://epro.uz
NUXT_PUBLIC_API_BASE=https://api.epro.uz
NUXT_PUBLIC_ADMIN_URL=https://admin.epro.uz
NUXT_PUBLIC_TELEGRAM_BOT=EproSupportBot

# ─── Headless WordPress CMS (server-only, NOT exposed to the browser) ───
# WPGraphQL endpoint of the headless WordPress instance.
WP_GRAPHQL_ENDPOINT=https://cms.epro.uz/graphql
# Shared secret the WordPress publish webhook sends to /api/revalidate.
# Generate a long random value, set the same value in WordPress.
WP_REVALIDATE_SECRET=change-me-to-a-long-random-string
# Optional (Phase 4): JWT token for previewing draft content.
# WP_PREVIEW_TOKEN=

# NOTE: On Coolify (runtime), set these as NUXT_-prefixed env vars so Nuxt's
# runtimeConfig picks them up at runtime, not just at build:
#   NUXT_WP_GRAPHQL_ENDPOINT, NUXT_WP_REVALIDATE_SECRET, NUXT_WP_PREVIEW_TOKEN
